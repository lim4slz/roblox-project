{
  "name": "Brightbrook",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "Request": { "$className": "RemoteFunction" },
        "ClientEvent": { "$className": "RemoteEvent" },
        "State": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      },
      "Packages": {
        "$className": "Folder",
        "ProfileStore": {
          "$path": "vendor/ProfileStore/ProfileStore.luau"
        }
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "Templates": {
        "$path": "src/server-templates"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 16,
        "CameraMaxZoomDistance": 70
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 96,
        "StreamingTargetRadius": 512,
        "SignalBehavior": "Deferred"
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Brightness": 2.4,
        "ClockTime": 14,
        "GeographicLatitude": 23,
        "GlobalShadows": true,
        "Ambient": [0.36, 0.36, 0.4],
        "OutdoorAmbient": [0.55, 0.55, 0.6],
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.28,
          "Offset": 0.12,
          "Color": [0.78, 0.86, 1.0],
          "Decay": [0.98, 0.82, 0.68],
          "Glare": 0.2,
          "Haze": 1.1
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.6,
          "Size": 28,
          "Threshold": 1.6
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.06,
          "Saturation": 0.12,
          "TintColor": [1.0, 0.99, 0.97]
        }
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
